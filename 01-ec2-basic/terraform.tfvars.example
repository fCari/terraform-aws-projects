# Copia este archivo a terraform.tfvars y ajusta los valores:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars no se sube al repositorio (.gitignore).

aws_region     = "us-east-1"
project_name   = "01-ec2-basic"
environment    = "lab"
instance_name  = "tf-lab-ec2"
instance_type  = "t3.micro"
ssh_ingress_cidr = "0.0.0.0/0"

# Nombre de un Key Pair existente en la región. Déjalo comentado si no vas a usar SSH.
# key_name = "mi-keypair"
